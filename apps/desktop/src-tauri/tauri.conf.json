{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Crux",
  "version": "0.7.1",
  "identifier": "com.crux.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @ai4s/desktop exec vite --port 5173 --strictPort",
    "beforeBuildCommand": "pnpm --filter @ai4s/desktop build",
    "beforeBundleCommand": "node ../../scripts/dev/build-computer-use.mjs"
  },
  "app": {
    "windows": [
      {
        "title": "Crux",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 640,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "zoomHotkeysEnabled": false,
        "trafficLightPosition": {
          "x": 13,
          "y": 26
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/opencode",
      "binaries/uv",
      "binaries/agent-browser",
      "binaries/crux"
    ],
    "macOS": {
      "hardenedRuntime": true,
      "infoPlist": "./Info.plist",
      "minimumSystemVersion": "13.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "nsis/hooks.nsh",
        "customLanguageFiles": {
          "English": "nsis/English.nsh"
        }
      }
    },
    "resources": {
      "../../../runtime/osd-plugin": "osd-plugin/",
        "../../../runtime/computer": "computer/",
        "../../../runtime/worktree": "worktree/",
        "computer-use": "computer-use/",
      "../../../runtime/skills/external/ai4s-skills": "skills/",
      "../../../runtime/skills/external/anthropic-skills": "skills-office/",
      "../../../runtime/skills/external/agent-browser": "skills-agent-browser/",
      "../../../runtime/skills/core": "skills-core/",
      "../../../runtime/skills/crux": "skills-crux/",
      "../../../runtime/opencode-profile/agent": "profile/agent/",
      "../../../runtime/opencode-profile/command": "profile/command/",
      "../../../runtime/harness": "harness/",
    "../../../runtime/acp-server": "acp-server/",
      "../../../examples/climate-trends": "examples/climate-trends/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
